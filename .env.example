# ============================================================
# StockSense AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_NAME=StockSense AI
APP_ENV=development
DEBUG=true
SECRET_KEY=add you key
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# ---- Database (PostgreSQL + TimescaleDB) ----
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=add password
POSTGRES_DB=stocksense
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ---- Celery ----
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ---- Free Data Provider API Keys ----
# Alpha Vantage (free tier: 25 requests/day)
# Get your key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep (free tier: 250 requests/day)
# Get your key at: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Finnhub (free tier: 60 calls/min)
# Get your key at: https://finnhub.io/register
FINNHUB_API_KEY=

# FRED (Federal Reserve Economic Data)
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC EDGAR — No API key required, but a User-Agent is mandatory
# Format: "CompanyName AdminEmail" (SEC requirement)
SEC_USER_AGENT=StockSenseAI admin@example.com

# ---- JWT Auth ----
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60
ANALYSIS_RATE_LIMIT_PER_DAY=100

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Frontend (Next.js public env vars) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=StockSense AI
